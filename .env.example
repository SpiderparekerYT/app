PORT=4000
APP_ORIGIN=https://prism.your-domain.com
SPOTIFY_CLIENT_ID=your_spotify_client_id
DATA_DIR=./data
UPLOADS_DIR=./uploads
PUSH_CONTACT_EMAIL=support@your-domain.com
VAPID_PUBLIC_KEY=your_web_push_public_key
VAPID_PRIVATE_KEY=your_web_push_private_key
APNS_TEAM_ID=your_apple_team_id
APNS_KEY_ID=your_apns_key_id
APNS_BUNDLE_ID=com.prism.social
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# App Store/TestFlight build:
# point the bundled iOS app at your live HTTPS Prism backend.
VITE_API_ORIGIN=https://prism.your-domain.com

# Optional:
# only set this when you intentionally want the native app to load a live site
# directly instead of the bundled frontend.
CAP_SERVER_URL=
